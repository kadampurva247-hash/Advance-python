from abc import ABC, abstractmethod

class Observer(ABC):
    @abstractmethod
    def update(self, temperature):
        pass


class MobileDisplay(Observer):
    def update(self, temperature):
        print(f"Mobile Display: Temperature = {temperature}°C")


class LCDDisplay(Observer):
    def update(self, temperature):
        print(f"LCD Display: Temperature = {temperature}°C")


class WeatherStation:
    def __init__(self):
        self.observers = []
        self.temperature = 0

    def register(self, observer):
        self.observers.append(observer)

    def unregister(self, observer):
        self.observers.remove(observer)

    def notify(self):
        for observer in self.observers:
            observer.update(self.temperature)

    def set_temperature(self, temperature):
        self.temperature = temperature
        print(f"\nWeather Station: Temperature changed to {temperature}°C")
        self.notify()


station = WeatherStation()

mobile = MobileDisplay()
lcd = LCDDisplay()

station.register(mobile)
station.register(lcd)

station.set_temperature(30)
station.set_temperature(35)
